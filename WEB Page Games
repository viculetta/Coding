            --------------------------CSS--------------------------













h1 {
    font-family: roboto;
    text-align: center;
    text-decoration: underline;
}

body {
    background-color: #000080;
    margin:none;
    padding:none;

}



.total {
    display: flex;
    justify-content: center;
    border: none;
    height: auto;
    flex-flow: row wrap;
    gap: 10px;
    justify-content: space-evenly;
    
}

.game {
    border: 5px solid white;
    min-width: 150px;
    max-width: 150px;
    min-height: 150px;
    max-height: 150px;
    margin: 10px 20px 30px 20px;
    border-radius: 10px;
    justify-content: space-evenly;
    border-radius: 25px;
    box-shadow: 0px 5px 0px rgba(0, 71, 143, 1);
    
    align-items: center;
    justify-content: center;
    padding: 4px;
}

.game:hover{
    background-color: #14AAAA;
    color: black !important;
}


.game-name {
    font-size: 30px;
    font-weight: bold;
    font-family: roboto;
    text-shadow: 2.5px 2.5px 0px rgba(128, 128, 128, 0.5);
    text-align: center;
    color: white;
}



a {
    text-decoration: none;
    color: white;
    
}


#smash-karts {
    width: 200px;

}

.top {
    display: flex;
    align-items: center;
    justify-content: center;
}



#boot {
    border-top: 2px solid white;
    background-color: #0B7373;
    height: 70px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color:white;
    
    padding: 0;
    
}

#down {
    font-size: 15px;
    text-align: center;
    text-decoration: underline;
}

.Games {
    color: white;
    font: 25px bold;
    border: 3px solid white;
    padding: 2px 3px;
    border-radius: 5px;
    box-shadow: 0px 5px 0px #14AAAA;
}

.Games:hover{
    background-color: #14AAAA;
    box-shadow: 0px 5px 0px #0B7373;
}

.discription {
    font-size: 10px;
}

#Games {
    color: black;
    font-size: 3.5rem;
}


.game-name2 {
    font-size: 28px;
    font-weight: bold;
    font-family: roboto;
    text-shadow: 2.5px 2.5px 0px rgba(128, 128, 128, 0.5);
    text-align: center;
    color: white;
}



.menu {
    background-color: #47D7C6;
    margin: -47px;
    padding: 1.5px;
}


.container {
    display: flex;
    
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
}

.pink-div {
    background-color: pink;
    width: 50%;
    height: 200px;
   
    
}

.white-div {
    background-color: white;
    width: 50%;
    height: 200px;
    background-image:url(https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS-IqDv1tOx6apIkblT-FdeMt8NQ7phT4Cz0w&s);
    left:50%;
}


.container2 {
    display: flex;
    align-items: end;
    justify-content: end;
}

.tran-div {
    position: absolute;
    right:0;
    width: 50%;
    height: 200px;
    background-color: rgba(225, 225, 225, 0.5);
    display: flex;
    justify-content: start;
    align-items: end;
}

#in-container {
    position: absolute;
    font-weight: bold;
    font-family: monospace;
    font-size: 50px;
    margin: 10px;
    z-index:2;
}

ul {
    color: white;
}

.typeogames {
    display:flex;
    flex-flow: row wrap;
    justify-content: space-evenly;
    font-size: 1.5rem;
    
}



#asterisc {
    color: white;
}

.image-credit {
    color: #363636;
}


.list {
    margin: 0 0 0 20px;
}

fieldset {
    width: 400px;
    height: 500px;
    line-height: 35px;
    margin:0 0 5rem 0;
    background-color: rgba(250, 218, 221, 0.5);
}


